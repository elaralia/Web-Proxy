# Only needed for nginx older than 1.19.4 (e.g. nginx 1.18 on Raspberry Pi OS 11 "bullseye"),
# which can't set the TLS 1.3 cipher order itself. Makes nginx prefer ChaCha20 for TLS 1.3.
# Used by nginx only, through a systemd override; see "Make HTTPS use ChaCha20" in README.md.
openssl_conf = default_conf

[default_conf]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
# Same defaults as Debian's /etc/ssl/openssl.cnf ...
MinProtocol = TLSv1.2
CipherString = DEFAULT@SECLEVEL=2
# ... plus ChaCha20 first, chosen by the server rather than the browser.
Ciphersuites = TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384
Options = ServerPreference
