# Copy this file to .env and edit it. Restart the service after changes:
#   sudo systemctl restart web-proxy

# Port the proxy listens on. Put nginx/Apache/Caddy in front of it for HTTPS.
PORT=8080
# 127.0.0.1 = only reachable through your reverse proxy (recommended).
# 0.0.0.0   = reachable directly on the network too.
HOST=127.0.0.1

# Password for the proxy. Strongly recommended: without one, anyone who finds
# your site can use your home internet connection.
PROXY_PASSWORD=

# Comma separated list of hostname patterns the proxy refuses to visit (regex).
# Example: BLOCKLIST=facebook\.com,tiktok\.com
BLOCKLIST=

# Optional DNS servers for the proxy to use instead of the Pi's default.
# Example (Cloudflare, with malware blocking): DNS_SERVERS=1.1.1.2,1.0.0.2
DNS_SERVERS=

# IPs of reverse proxies to trust for the visitor's real IP (used by login rate limiting).
TRUST_PROXY=127.0.0.1,::1

# DANGEROUS: allow proxy users to reach devices on your home network. Leave false.
ALLOW_LOCAL_NETWORK=false

# info or debug
LOG_LEVEL=info
